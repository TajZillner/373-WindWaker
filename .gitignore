# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
Unreal/WindWaker377/SourceArt/**/*.png
Unreal/WindWaker377/SourceArt/**/*.tga

# Binary Files
Unreal/WindWaker377/Binaries/*
Unreal/WindWaker377/Plugins/**/Binaries/*

# Builds
Unreal/WindWaker377/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Unreal/WindWaker377/Build/*/
Unreal/WindWaker377/Build/*/**
!Unreal/WindWaker377/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Unreal/WindWaker377/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Unreal/WindWaker377/Saved/*

# Compiled source files for the engine to use
Unreal/WindWaker377/Intermediate/*
Unreal/WindWaker377/Plugins/**/Intermediate/*

# Cache files for the editor to use
Unreal/WindWaker377/DerivedDataCache/*
